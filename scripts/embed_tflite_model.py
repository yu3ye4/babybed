#!/usr/bin/env python3
"""Generate firmware C sources from a TFLite model."""

from __future__ import annotations

import argparse
from pathlib import Path
from textwrap import wrap


HEADER_TEMPLATE = """#ifndef AI_MODEL_H__
#define AI_MODEL_H__

#include <rtthread.h>

#ifdef __cplusplus
extern "C" {{
#endif

#define AI_MODEL_INPUT_WIDTH      {width}U
#define AI_MODEL_INPUT_HEIGHT     {height}U
#define AI_MODEL_INPUT_CHANNELS   {channels}U

extern const rt_uint8_t g_ai_model_data[];
extern const rt_size_t g_ai_model_size;

const rt_uint8_t *ai_model_get_data(void);
rt_size_t ai_model_get_size(void);

#ifdef __cplusplus
}}
#endif

#endif /* AI_MODEL_H__ */
"""


SOURCE_PREFIX = """#include "ai_model.h"

#if defined(__ICCARM__)
#pragma data_alignment=16
#define AI_MODEL_ALIGN
#elif defined(__CC_ARM)
#define AI_MODEL_ALIGN __align(16)
#else
#define AI_MODEL_ALIGN __attribute__((aligned(16)))
#endif

AI_MODEL_ALIGN const rt_uint8_t g_ai_model_data[] =
{
"""


SOURCE_SUFFIX = """};

const rt_size_t g_ai_model_size = sizeof(g_ai_model_data);

const rt_uint8_t *ai_model_get_data(void)
{
    return g_ai_model_data;
}

rt_size_t ai_model_get_size(void)
{
    return g_ai_model_size;
}
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Embed a TFLite model as RT-Thread C source/header files."
    )
    parser.add_argument("model", type=Path, help="Input .tflite model")
    parser.add_argument(
        "--out-dir",
        type=Path,
        default=Path("cm33-app/applications"),
        help="Directory for ai_model.c and ai_model.h",
    )
    parser.add_argument("--width", type=int, default=320)
    parser.add_argument("--height", type=int, default=320)
    parser.add_argument("--channels", type=int, default=3)
    return parser.parse_args()


def format_model_bytes(data: bytes) -> str:
    hex_bytes = [f"0x{byte:02X}" for byte in data]
    lines = []
    for line in wrap(", ".join(hex_bytes), width=96):
        lines.append(f"    {line}")
    return ",\n".join(lines) + "\n"


def main() -> int:
    args = parse_args()
    model_path = args.model
    out_dir = args.out_dir

    data = model_path.read_bytes()
    out_dir.mkdir(parents=True, exist_ok=True)

    (out_dir / "ai_model.h").write_text(
        HEADER_TEMPLATE.format(
            width=args.width,
            height=args.height,
            channels=args.channels,
        ),
        encoding="utf-8",
        newline="\n",
    )

    (out_dir / "ai_model.c").write_text(
        SOURCE_PREFIX + format_model_bytes(data) + SOURCE_SUFFIX,
        encoding="utf-8",
        newline="\n",
    )

    print(f"Embedded {model_path} ({len(data)} bytes) into {out_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
